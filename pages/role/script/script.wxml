<scroll-view scroll-y class="page">
  <view class="hero">
    <text class="hero-title">{{pageTitle}}</text>
    <text class="hero-sub">填空生成 · 含亮相串词与结束报告</text>
  </view>

  <view class="body">
    <scroll-view scroll-x class="role-tabs" enable-flex>
      <view
        class="tab {{tab === item.id ? 'active' : ''}}"
        wx:for="{{roleList}}"
        wx:key="id"
        bindtap="switchTab"
        data-tab="{{item.id}}"
      >{{item.title}}</view>
    </scroll-view>

    <view class="form">
      <view class="field" wx:for="{{fields}}" wx:key="key">
        <text class="label">{{item.label}}</text>
        <input class="input" placeholder="{{item.placeholder}}" value="{{values[item.key]}}" data-key="{{item.key}}" bindinput="onFieldInput" />
      </view>
      <button class="gen-btn" bindtap="onGenerate">生成稿件</button>
    </view>

    <view class="output" wx:if="{{sections.length}}">
      <view class="out-head">
        <text class="out-title">生成结果</text>
        <text class="copy" bindtap="onCopy">复制全文</text>
      </view>
      <view class="sec" wx:for="{{sections}}" wx:key="title">
        <text class="sec-title">{{item.title}}</text>
        <text class="sec-body">{{item.content}}</text>
      </view>
    </view>
  </view>
</scroll-view>
