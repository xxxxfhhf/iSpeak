.page {
  height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ff9500, #ffb340);
  padding: 48rpx 40rpx 56rpx;
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 10rpx;
  display: block;
}

.body {
  padding: 0 24rpx 40rpx;
  margin-top: -24rpx;
}

.role-tabs {
  white-space: nowrap;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.tab {
  display: inline-block;
  text-align: center;
  padding: 14rpx 24rpx;
  margin-right: 8rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 12rpx;
}

.tab.active {
  background: #ff9500;
  color: #fff;
  font-weight: 600;
}

.form {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.field {
  margin-bottom: 24rpx;
}

.field:last-of-type {
  margin-bottom: 8rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.gen-btn {
  background: #ff9500;
  color: #fff;
  border-radius: 44rpx;
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 149, 0, 0.28);
}

.gen-btn::after {
  border: none;
}

.output {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.out-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.out-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.copy {
  font-size: 26rpx;
  color: #007aff;
}

.sec {
  margin-bottom: 28rpx;
}

.sec:last-child {
  margin-bottom: 0;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff9500;
  display: block;
  margin-bottom: 10rpx;
}

.sec-body {
  font-size: 28rpx;
  color: #444;
  line-height: 1.85;
  white-space: pre-wrap;
  display: block;
}
