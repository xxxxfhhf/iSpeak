/* 时间牌 — 深色沉浸 + 自定义规则面板 */
.page {
  min-height: 100vh;
  background: #111;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.preset-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.dur {
  color: #ff9500;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(255, 149, 0, 0.45);
  border-radius: 32rpx;
}

.dur.active {
  background: #ff9500;
  color: #fff;
  border-color: #ff9500;
}

.custom-panel {
  background: #1c1c1e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-row {
  margin-bottom: 8rpx;
}

.label {
  width: 120rpx;
  color: #aaa;
  font-size: 26rpx;
  flex-shrink: 0;
}

.num {
  width: 100rpx;
  background: #2c2c2e;
  color: #fff;
  text-align: center;
  border-radius: 8rpx;
  padding: 10rpx 0;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.unit {
  color: #888;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.tip {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.save-btn {
  margin-top: 12rpx;
  background: #ff9500;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.save-btn::after {
  border: none;
}

.card-display {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  min-height: 320rpx;
  margin-bottom: 24rpx;
}

.card-none { background: #222; }
.card-green { background: #34c759; }
.card-yellow { background: #ffcc00; }
.card-red { background: #ff3b30; }

.time {
  font-size: 128rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}

.card-label {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 20rpx;
  font-weight: 500;
}

.rule-summary {
  text-align: center;
  color: #666;
  font-size: 22rpx;
  margin-bottom: 24rpx;
}

.btns {
  display: flex;
  gap: 16rpx;
}

.btns button {
  flex: 1;
  background: #333;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btns button::after {
  border: none;
}

.page { height: 100vh; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.card-display { min-height: 340rpx; }
.card-green { background: #15824b; }
.card-yellow { background: #f5c842; }
.card-yellow .time,.card-yellow .card-label,.card-yellow .time-unit { color: #302700; }
.time { font-size: 148rpx; }
.time-unit { color: #fff; font-size: 26rpx; margin-top: 8rpx; }
.rule-summary { color: #c1c6cd; font-size: 24rpx; line-height: 1.6; }
.dur { min-height: 48px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.btns button { min-height: 52px; }
.tip { color: #c1c6cd; }
