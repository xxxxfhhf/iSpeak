<!-- 角色职责：点击生成对应主持稿/串词 -->
<scroll-view scroll-y class="page">
  <view class="hero">
    <text class="hero-title">角色职责</text>
    <text class="hero-sub">点击角色 → 生成亮相串词与结束报告</text>
  </view>

  <view class="list">
    <view class="item" wx:for="{{roles}}" wx:key="role" bindtap="onRoleTap" data-script-id="{{item.scriptId}}" data-role="{{item.role}}">
      <view class="item-main">
        <text class="role">{{item.role}}</text>
        <text class="duty">{{item.duty}}</text>
      </view>
      <text class="item-action">生成稿 ›</text>
    </view>
  </view>
</scroll-view>
