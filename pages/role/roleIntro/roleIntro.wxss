.page {
  height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ff9500, #ffb340);
  padding: 48rpx 40rpx 56rpx;
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 10rpx;
  display: block;
}

.list {
  padding: 0 24rpx 40rpx;
  margin-top: -24rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #ff9500;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item:last-child {
  margin-bottom: 0;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.role {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff9500;
  display: block;
}

.duty {
  font-size: 26rpx;
  color: #555;
  line-height: 1.75;
  margin-top: 10rpx;
  display: block;
}

.item-action {
  font-size: 24rpx;
  color: #007aff;
  flex-shrink: 0;
}
