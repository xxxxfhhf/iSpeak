<!-- 角色 Tab — 时间牌 / 角色介绍 / 主持稿 / 议程表 -->
<scroll-view scroll-y class="page">
  <view class="hero">
    <text class="hero-title">角色工具箱</text>
    <text class="hero-sub">会议现场实用工具</text>
  </view>

  <view class="tool-grid">
    <view class="tool-card primary" bindtap="onAgenda">
      <text class="tool-icon">📋</text>
      <view class="tool-text">
        <text class="tool-name">议程表搭建</text>
        <text class="tool-desc">积木填写 · 预览 · 分享 · 导出</text>
      </view>
    </view>
    <view class="tool-card" bindtap="onTimer">
      <text class="tool-icon">🟢</text>
      <text class="tool-name">时间牌</text>
      <text class="tool-desc">绿/黄/红牌计时</text>
    </view>
    <view class="tool-card" bindtap="onRoleIntro">
      <text class="tool-icon">🎭</text>
      <text class="tool-name">角色介绍</text>
      <text class="tool-desc">各角色职责说明</text>
    </view>
    <view class="tool-card" bindtap="onScript">
      <text class="tool-icon">🎤</text>
      <text class="tool-name">主持稿生成</text>
      <text class="tool-desc">总主持 / 即兴主持模板</text>
    </view>
  </view>
</scroll-view>
