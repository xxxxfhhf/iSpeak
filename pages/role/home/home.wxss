/* 角色 Tab — 简洁卡片网格，配色不变 */
.page {
  height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ff9500, #ffb340);
  padding: 56rpx 40rpx 64rpx;
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.88;
  margin-top: 12rpx;
  display: block;
}

.tool-grid {
  padding: 28rpx 24rpx 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: -32rpx;
}

.tool-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.tool-card.primary {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-left: none;
  background: linear-gradient(135deg, #fff 0%, #fffaf5 100%);
  box-shadow: 0 8rpx 32rpx rgba(255, 149, 0, 0.12);
}

.tool-card.primary .tool-icon {
  margin-bottom: 0;
  font-size: 52rpx;
}

.tool-card.primary .tool-text {
  flex: 1;
}

.tool-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.tool-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
  line-height: 1.5;
}
