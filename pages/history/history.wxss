.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f8f8;
}

.header {
  padding: 30rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
  position: relative;
  z-index: 101; /* 保证菜单在遮罩之上 */
}

.search-box {
  flex: 1;
  height: 72rpx;
  background-color: #f2f2f2;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 10rpx;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}

.library-btn {
  font-size: 36rpx;
  width: 72rpx;
  background-color: #f8f8f8;
  border-radius: 50%;
}

.new-btn-wrapper {
  position: relative;
}

.new-btn {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  background-color: #007aff;
  padding: 12rpx 30rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

/* 气泡菜单 */
.popover-menu {
  position: absolute;
  top: 90rpx;
  right: 0;
  width: 360rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  padding: 10rpx 0;
  opacity: 0;
  transform: translateY(-10rpx) scale(0.95);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  z-index: 200;
}

.popover-menu.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

/* 气泡小三角 */
.popover-menu::before {
  content: '';
  position: absolute;
  top: -10rpx;
  right: 40rpx;
  width: 20rpx;
  height: 20rpx;
  background-color: #fff;
  transform: rotate(45deg);
  box-shadow: -2rpx -2rpx 4rpx rgba(0, 0, 0, 0.05);
  z-index: -1;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  transition: background-color 0.1s;
}

.menu-item:active {
  background-color: #f5f5f5;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-content {
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
}

.menu-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 0 20rpx;
}

.ai-item .menu-title {
  color: #007aff;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: transparent;
  z-index: 100;
}

.project-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.project-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  position: relative;
  transition: all 0.2s;
}

.project-card.selected {
  background-color: #f0f7ff;
  border: 2rpx solid #007aff;
}

.project-info {
  flex: 1;
  overflow: hidden; /* 防止内容溢出 */
}

.project-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.title-wrapper {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
  margin-right: 20rpx;
}

.project-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ai-indicator {
  font-size: 18rpx;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.more-btn {
  width: 60rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.more-dot {
  font-weight: bold;
  color: #999;
  font-size: 40rpx;
  line-height: 20rpx; /* 调整点的位置 */
}

.project-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.type-tag {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: #666;
  background-color: #f0f0f0; /* 统一改为淡灰色，不抢视觉 */
}

/* 移除特定的颜色类，保持统一清爽 */
/* .type-tag.toastmasters_story { ... } */

.meta-divider {
  font-size: 20rpx;
  color: #ccc;
  margin: 0 10rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999;
}

.progress-bar-container {
  height: 4rpx; /* 变细 */
  background-color: #f5f5f5;
  border-radius: 2rpx;
  overflow: hidden;
  width: 100%;
}

.progress-bar {
  height: 100%;
  background-color: #007aff;
  border-radius: 2rpx;
  opacity: 0.6; /* 降低一点透明度 */
}

/* 移除旧的按钮样式 */
.project-actions, .action-item {
  display: none;
}

.select-icon {
  margin-left: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.list-footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: #ccc;
}

.batch-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.batch-info {
  font-size: 28rpx;
  color: #333;
}

.batch-btns {
  display: flex;
  gap: 20rpx;
}

.batch-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.batch-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.batch-btn.delete {
  background-color: #ff3b30;
  color: #fff;
}

