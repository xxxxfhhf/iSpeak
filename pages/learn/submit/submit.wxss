.container { min-height: 100vh; background: #f5f7fa; padding: 24rpx; box-sizing: border-box; }
.header { background: #fff; padding: 28rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.title { font-size: 34rpx; font-weight: bold; color: #333; display: block; }
.sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }

.form-section { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.label { font-size: 26rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }
.textarea { width: 100%; min-height: 200rpx; font-size: 28rpx; line-height: 1.6; box-sizing: border-box; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item { position: relative; width: 160rpx; height: 160rpx; }
.thumb { width: 100%; height: 100%; border-radius: 8rpx; }
.remove { position: absolute; top: -8rpx; right: -8rpx; width: 36rpx; height: 36rpx; background: #ff3b30; color: #fff; border-radius: 50%; text-align: center; line-height: 36rpx; font-size: 24rpx; }
.add-btn { width: 160rpx; height: 160rpx; border: 2rpx dashed #ccc; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #ccc; }

.submit-btn { background: #007aff; color: #fff; border-radius: 40rpx; margin-top: 8rpx; }

.history { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-top: 24rpx; }
.history-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.history-item { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.history-time { font-size: 22rpx; color: #999; display: block; }
.history-text { font-size: 26rpx; color: #555; margin-top: 4rpx; display: block; }
