.container { min-height: 100vh; background: #f5f7fa; padding: 24rpx; box-sizing: border-box; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.header { background: #fff; padding: 28rpx; border-radius: 12rpx; margin-bottom: 16rpx; }

.title { font-size: 34rpx; font-weight: bold; color: #333; display: block; }

.sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }

.form-section { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; }

.label { font-size: 26rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }

.textarea { width: 100%; min-height: 200rpx; font-size: 28rpx; line-height: 1.6; box-sizing: border-box; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }

.image-item { position: relative; width: 160rpx; height: 160rpx; }

.thumb { width: 100%; height: 100%; border-radius: 8rpx; }

.remove { position: absolute; top: -8rpx; right: -8rpx; width: 36rpx; height: 36rpx; background: #ff3b30; color: #fff; border-radius: 50%; text-align: center; line-height: 36rpx; font-size: 24rpx; }

.add-btn { width: 160rpx; height: 160rpx; border: 2rpx dashed #ccc; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #ccc; }

.submit-btn { background: #007aff; color: #fff; border-radius: 40rpx; margin-top: 8rpx; }

.history { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-top: 24rpx; }

.history-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }

.history-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }

.history-item:last-child { border-bottom: none; }

.history-head { display: flex; align-items: center; justify-content: space-between; }

.history-time { font-size: 22rpx; color: #999; }

.history-badge { font-size: 20rpx; color: #007aff; background: #f0f7ff; padding: 4rpx 12rpx; border-radius: 8rpx; }

.history-text { font-size: 26rpx; color: #555; margin-top: 8rpx; display: block; line-height: 1.5; }

.history-thumb-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }

.history-thumb { width: 120rpx; height: 120rpx; border-radius: 8rpx; background: #eee; }

.history-expired { font-size: 22rpx; color: #ff9500; margin-top: 8rpx; display: block; }

/* 详情弹层 */
.detail-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 30rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }

.detail-title { font-size: 32rpx; font-weight: bold; color: #333; }

.detail-close { font-size: 44rpx; color: #999; line-height: 1; padding: 0 8rpx; }

.detail-time { font-size: 24rpx; color: #999; display: block; margin-bottom: 20rpx; }

.detail-body { max-height: 60vh; }

.detail-text { font-size: 28rpx; color: #333; line-height: 1.8; display: block; white-space: pre-wrap; }

.detail-text.muted { color: #999; }

.detail-images { margin-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }

.detail-image { width: 100%; border-radius: 12rpx; background: #f5f5f5; }

.detail-expired { font-size: 26rpx; color: #ff9500; margin-top: 20rpx; display: block; }
