.container { display: flex; flex-direction: column; height: 100vh; background: #f5f7fa; }
.stage-header { background: #fff; padding: 30rpx; }
.stage-title { font-size: 36rpx; font-weight: bold; color: #333; display: block; }
.stage-desc { font-size: 26rpx; color: #666; margin-top: 8rpx; display: block; }
.unlock-hint { margin-top: 16rpx; padding: 12rpx 16rpx; background: #fff8e6; border-radius: 8rpx; font-size: 24rpx; color: #ff9500; }
.tabs { display: flex; background: #fff; padding: 0 30rpx; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: #999; border-bottom: 4rpx solid transparent; }
.tab.active { color: #007aff; font-weight: bold; border-bottom-color: #007aff; }
.list { flex: 1; padding: 20rpx; box-sizing: border-box; }
.group-label { font-size: 26rpx; font-weight: bold; color: #666; padding: 16rpx 8rpx 8rpx; }
.empty-hint { font-size: 24rpx; color: #ccc; padding: 16rpx 8rpx 24rpx; }
.path-card.elective { border-left-color: #bbb; }
.list-item.elective { border-left: 4rpx solid #ddd; }
.path-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; border-left: 6rpx solid #007aff; }
.path-card.done { border-left-color: #34c759; }
.done-label { font-size: 24rpx; color: #34c759; margin-top: 12rpx; display: block; }
.list-item { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; }
.item-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; }
.item-code { font-size: 22rpx; color: #007aff; font-weight: bold; }
.item-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-top: 4rpx; }
.item-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }
.item-meta { font-size: 22rpx; color: #007aff; margin-top: 8rpx; display: block; }
.type-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.type-tag.req { background: #e8f4fd; color: #007aff; }
.type-tag.opt { background: #f0f0f0; color: #999; }

/* 阶段页末尾：结语 + 特别感谢 */
.epilogue-section,
.thanks-section {
  margin-top: 32rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.epilogue-section { border-top: 4rpx solid #ff9500; }
.thanks-section { border-top: 4rpx solid #5856d6; }

.section-head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-head-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.toggle { font-size: 22rpx; color: #007aff; }

.block-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #5856d6;
  margin-bottom: 12rpx;
}

.block-paragraph {
  font-size: 26rpx;
  color: #555;
  line-height: 1.85;
  margin-bottom: 16rpx;
  text-align: justify;
}

.oa-inline {
  margin: 24rpx 0 40rpx;
  padding: 20rpx 24rpx;
  background: #fff8f0;
  border: 1rpx solid #ffe0b2;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #ff9500;
  text-align: center;
}
