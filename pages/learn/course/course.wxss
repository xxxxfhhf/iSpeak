.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

.header {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.code {
  font-size: 24rpx;
  color: #007aff;
  font-weight: bold;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-top: 8rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 12rpx;
}

.tag.req { background: #e8f4fd; color: #007aff; }
.tag.opt { background: #f0f0f0; color: #999; }

.content {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 26rpx;
  color: #007aff;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

/* 学习内容摘要 */
.learn-section { border-left: 6rpx solid #007aff; }
.section-summary {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 课程正文排版 */
.body-section { padding-bottom: 32rpx; }

.rich-body { padding-top: 4rpx; }

.block-chapter {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #007aff;
  line-height: 1.6;
  margin: 28rpx 0 16rpx;
  padding: 12rpx 16rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  border-left: 6rpx solid #007aff;
}

.block-subheading {
  font-size: 29rpx;
  font-weight: bold;
  color: #ff9500;
  line-height: 1.6;
  margin: 20rpx 0 12rpx;
  padding: 8rpx 16rpx;
  background: #fff8f0;
  border-radius: 8rpx;
}

.block-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #5856d6;
  line-height: 1.7;
  margin: 20rpx 0 10rpx;
}

.block-list-item {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.85;
  margin-bottom: 16rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #34c759;
}

.block-bullet {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.85;
  margin-bottom: 12rpx;
  padding-left: 24rpx;
  position: relative;
}

.block-paragraph {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
  margin-bottom: 20rpx;
  text-align: justify;
}

.block-example-title {
  display: inline-block;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  background: #ff9500;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin: 24rpx 0 12rpx;
}

.block-example {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.9;
  background: #faf8f5;
  border: 1rpx solid #f0e6d8;
  border-left: 6rpx solid #ff9500;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.inline-link {
  color: #007aff;
  text-decoration: underline;
}

.inline-image {
  color: #ff9500;
  font-weight: bold;
  text-decoration: underline;
}

.image-gallery {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e0e0e0;
}

.gallery-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.gallery-thumb {
  width: 100%;
  height: 320rpx;
  background: #eee;
}

.gallery-caption {
  font-size: 24rpx;
  color: #555;
  padding: 12rpx 16rpx;
  display: block;
}

/* 练习目标 */
.goal-section {
  border-left: 6rpx solid #34c759;
  background: #f8fdf9;
}

.goal-label { color: #34c759; }

.goal-text {
  font-size: 28rpx;
  color: #2e7d32;
  line-height: 1.8;
  font-weight: 500;
}

.status-bar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  font-size: 24rpx;
  color: #666;
}

.status-label.ok {
  color: #4caf50;
  font-weight: bold;
}

.actions {
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  background: #f0f0f0;
  color: #333;
}

.btn.primary {
  background: #007aff;
  color: #fff;
}

/* 演练写稿联动区 */
.draft-section {
  border-left: 6rpx solid #5856d6;
  background: #f8f7ff;
  margin-bottom: 24rpx;
}

.draft-label { color: #5856d6; }

.draft-hint {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.draft-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.draft-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.draft-btns {
  display: flex;
  gap: 16rpx;
}

.draft-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  margin: 0;
  padding: 0;
}

.draft-btn.primary {
  background: #5856d6;
  color: #fff;
}

.draft-btn.outline {
  background: #fff;
  color: #5856d6;
  border: 1rpx solid #5856d6;
}

.oa-link {
  text-align: center;
  padding: 16rpx 30rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  font-size: 24rpx;
  color: #ff9500;
}
