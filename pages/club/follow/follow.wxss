.page-scroll {
  height: 100vh;
  background: #f5f7fa;
}

.container {
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero {
  text-align: center;
  margin-bottom: 32rpx;
}

.hero-icon {
  font-size: 72rpx;
  display: block;
}

.hero-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-top: 16rpx;
  display: block;
}

.hero-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
  display: block;
}

.oa-component-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.steps-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.step-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.step-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.step-type {
  font-size: 24rpx;
  color: #fff;
  background: #ff9500;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.step-keyword {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.step-tip {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
}

.copy-btn {
  font-size: 26rpx;
  color: #007aff;
  background: #f0f7ff;
  border: 1rpx solid #cce4ff;
  border-radius: 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
}

.hint-card {
  background: #fffbf5;
  border: 1rpx solid #ffe0b2;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.btn.primary {
  background: #ff9500;
  color: #fff;
}

.btn.outline {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.native-note {
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
  display: block;
  text-align: center;
}
