/* 官员 Tab — 统一留白与卡片层次 */
.page {
  height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #5856d6, #7b6cf6);
  padding: 56rpx 40rpx 64rpx;
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.88;
  margin-top: 12rpx;
  display: block;
}

.card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.card:first-of-type {
  margin-top: -32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #5856d6;
  line-height: 1.4;
}

.action-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.action-row:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.action-row:first-of-type {
  padding-top: 16rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
  line-height: 1.5;
}

.action-arrow {
  color: #ddd;
  font-size: 32rpx;
  margin-left: 8rpx;
}

.duty-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.duty-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.duty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5856d6;
  display: block;
}

.duty-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.75;
  margin-top: 8rpx;
  display: block;
}

.officer-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f8f8f8;
  align-items: center;
}

.officer-row:last-child {
  border-bottom: none;
}

.officer-row.head {
  font-weight: 600;
  color: #666;
  background: #f8f9fa;
  margin: 8rpx -28rpx 0;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  border-bottom: none;
}

.col-title {
  flex: 2;
}

.col-name {
  flex: 1;
}

.col-phone {
  flex: 2;
  text-align: right;
  color: #888;
  font-size: 24rpx;
}
