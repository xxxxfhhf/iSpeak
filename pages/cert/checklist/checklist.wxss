.container { min-height: 100vh; background: #f5f7fa; padding: 24rpx; box-sizing: border-box; }
.header { background: #fff; padding: 28rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.title { font-size: 34rpx; font-weight: bold; color: #333; display: block; }
.sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }

.check-item { display: flex; background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 12rpx; align-items: flex-start; }
.check-item.done { border-left: 6rpx solid #34c759; }
.check-icon { width: 48rpx; height: 48rpx; border-radius: 50%; background: #f0f0f0; text-align: center; line-height: 48rpx; font-size: 24rpx; color: #999; flex-shrink: 0; margin-right: 16rpx; }
.check-item.done .check-icon { background: #34c759; color: #fff; }
.check-body { flex: 1; }
.check-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; }
.check-desc { font-size: 24rpx; color: #666; margin-top: 6rpx; display: block; line-height: 1.5; }
.auto-tag { font-size: 20rpx; color: #007aff; margin-top: 8rpx; display: inline-block; background: #e8f4fd; padding: 2rpx 10rpx; border-radius: 4rpx; }

.actions { margin-top: 24rpx; }
.btn { margin-bottom: 16rpx; border-radius: 40rpx; font-size: 28rpx; }
.btn.primary { background: #667eea; color: #fff; }
.btn.primary[disabled] { opacity: 0.5; }
