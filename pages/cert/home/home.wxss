.page-scroll { height: 100vh; background: #f5f0ff; }

.container { padding: 40rpx 30rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

.hero { text-align: center; margin-bottom: 8rpx; }

.hero-icon { font-size: 80rpx; display: block; }

.hero-title { font-size: 40rpx; font-weight: bold; margin-top: 16rpx; display: block; }

.hero-desc { font-size: 26rpx; color: #666; margin-top: 8rpx; display: block; }

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  text-align: left;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }

.card-head .info-title { margin-bottom: 0; }

.info-hint { font-size: 22rpx; color: #999; display: block; margin-bottom: 16rpx; }

.info-step { font-size: 24rpx; color: #555; line-height: 1.8; display: block; }

.toggle { font-size: 22rpx; color: #5856d6; }

.flow-card { border-left: 6rpx solid #5856d6; }

.rich-content { margin-top: 8rpx; }

.block-paragraph {
  font-size: 26rpx;
  color: #555;
  line-height: 1.85;
  margin-bottom: 16rpx;
}

.block-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #5856d6;
  margin: 12rpx 0 8rpx;
}

.block-bullet {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 8rpx;
  padding-left: 12rpx;
}

.benefit-table {
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.benefit-row {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 24rpx;
}

.benefit-row.head { background: #f5f0ff; font-weight: bold; color: #666; }

.benefit-row:last-child { border-bottom: none; }

.col-item { flex: 2; color: #333; }

.col-member, .col-mentor { flex: 1; text-align: center; color: #666; }

.col-mentor.highlight { color: #5856d6; font-weight: bold; }

.btn { margin-top: 24rpx; border-radius: 44rpx; font-size: 28rpx; width: 100%; }

.btn.primary { background: #5856d6; color: #fff; }

.oa-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-top: 32rpx;
  background: linear-gradient(135deg, #fff8f0 0%, #fff 100%);
  border: 1rpx solid #ffe0b2;
  border-radius: 16rpx;
}

.oa-icon { font-size: 40rpx; margin-right: 20rpx; }

.oa-info { flex: 1; display: flex; flex-direction: column; }

.oa-title { font-size: 28rpx; font-weight: bold; color: #333; }

.oa-sub { font-size: 24rpx; color: #888; margin-top: 6rpx; }

.oa-arrow { font-size: 36rpx; color: #ccc; }
