<view class="page">
  <view class="header">
    <text class="title">每日晨读</text>
    <text class="date" wx:if="{{date}}">{{date}}</text>
    <view class="archive-link" wx:if="{{!isHistory}}" bindtap="onGoArchive">历史素材</view>
    <view class="refresh" bindtap="onRefresh">刷新</view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <view wx:elif="{{error}}" class="tip error">
    <text>{{error}}</text>
    <view class="btn" wx:if="{{!isHistory}}" bindtap="onRegenerate">生成今日素材</view>
  </view>

  <block wx:else>
    <view class="card" wx:for="{{cards}}" wx:key="idx">
      <view class="card-top">
        <text class="tag tag-{{item.kind}}">{{item.label}}</text>
        <text class="card-title" wx:if="{{item.title}}">{{item.title}}</text>
      </view>
      <text class="card-body" user-select="{{true}}" space="nbsp" decode="{{true}}">{{item.body}}</text>
      <view class="card-foot">
        <text class="meta">{{item.meta}}{{item.meta && item.source ? ' · ' : ''}}{{item.source}}</text>
        <text class="copy" data-idx="{{item.idx}}" bindtap="onCopy">复制</text>
      </view>
    </view>

    <view class="regen" wx:if="{{!isHistory}}" bindtap="onRegenerate">重新生成今日素材</view>
  </block>
</view>
