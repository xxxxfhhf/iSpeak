.page{padding:32rpx;background:#f4f6fa;min-height:100vh;box-sizing:border-box}.title,.sub{display:block}.title{font-size:40rpx;font-weight:600}.sub{font-size:28rpx;color:#65748a;line-height:1.7;margin:20rpx 0}input,textarea{box-sizing:border-box;width:100%;background:white;padding:24rpx;margin:20rpx 0;border-radius:16rpx;font-size:30rpx}input{height:100rpx}textarea{height:450rpx}label{font-size:26rpx}button{margin-top:24rpx;background:#174da6;color:white}