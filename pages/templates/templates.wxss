.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f8f8;
}

/* Tabs */
.tabs-scroll {
  height: 100rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  padding: 0 20rpx;
  height: 100%;
  align-items: center;
}

.tab-item {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  margin-right: 20rpx;
  transition: all 0.2s;
  flex-shrink: 0;
}

.tab-item.active {
  background-color: #007aff;
  color: #fff;
  font-weight: bold;
}

/* List */
.templates-list {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.template-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}

.template-card:active {
  transform: scale(0.99);
  transition: transform 0.1s;
}

.card-header {
  margin-bottom: 30rpx;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.template-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.tags-row {
  display: flex;
  gap: 10rpx;
}

.tag {
  font-size: 20rpx;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.template-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
  display: block;
}

/* Structure Preview */
.structure-preview {
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  margin-bottom: 30rpx;
}

.preview-line {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 31rpx; /* dot center */
  width: 2rpx;
  background-color: #e0e0e0;
}

.structure-step {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.structure-step:last-child {
  margin-bottom: 0;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ccc;
  margin-right: 20rpx;
  border: 4rpx solid #f9f9f9; /* hole mask */
}

.step-dot.small {
  width: 8rpx;
  height: 8rpx;
  margin-left: 4rpx;
}

.step-text {
  font-size: 24rpx;
  color: #666;
}

.step-text.more {
  color: #ccc;
}

/* Footer */
.card-footer {
  display: flex;
  justify-content: flex-end;
}

.use-btn {
  font-size: 26rpx;
  font-weight: bold;
  color: #007aff;
  padding: 12rpx 30rpx;
  background-color: rgba(0, 122, 255, 0.05);
  border-radius: 30rpx;
}

.empty-space {
  height: 60rpx;
}