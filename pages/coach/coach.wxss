.page{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;padding:36rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));background:radial-gradient(ellipse at 50% 55%,#102e46 0%,#080f20 55%,#070b16 100%);color:#edf8ff;overflow:hidden}.top{display:flex;align-items:center;justify-content:space-between}.brand{display:block;font-size:28rpx;letter-spacing:6rpx;font-weight:600}.subtitle{display:block;font-size:24rpx;color:#91a7be;margin-top:12rpx}.more{margin:0;background:transparent;color:#c4d7e9;width:48px;height:48px;line-height:40px;font-size:40rpx}.more::after,.orb::after{border:0}.dialogue{margin-top:48rpx;height:28vh;min-height:160rpx}.eyebrow{display:block;color:#73e0dc;font-size:24rpx;letter-spacing:4rpx;margin-bottom:20rpx}.reply{height:calc(100% - 50rpx);font-size:36rpx;line-height:1.7;white-space:pre-wrap}.orb-stage{flex:1;min-height:230rpx;display:flex;align-items:center;justify-content:center}.orb{width:320rpx;height:320rpx;max-height:28vh;max-width:28vh;position:relative;overflow:visible;background:transparent;border-radius:50%;padding:0;display:flex;align-items:center;justify-content:center}.halo{position:absolute;inset:0;border:1rpx solid rgba(98,229,237,.35);border-radius:50%;animation:breathe 4s ease-in-out infinite;pointer-events:none}.halo-two{inset:-28rpx;animation-delay:-2s;border-color:rgba(123,159,255,.2)}.core{width:82%;height:82%;border-radius:50%;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 30% 28%,#c4fff0 0%,#5bd6da 22%,#337eaf 56%,#394481 83%);box-shadow:inset -12rpx -18rpx 30rpx rgba(5,15,58,.5),0 0 66rpx rgba(68,196,230,.22);animation:core-breathe 4s ease-in-out infinite}.wave{display:flex;align-items:center;gap:9rpx;height:60rpx}.wave view{width:7rpx;border-radius:8rpx;height:20rpx;background:#e5ffff}.wave view:nth-child(2),.wave view:nth-child(4){height:35rpx}.wave view:nth-child(3){height:52rpx}.listening .wave view{animation:wave .65s ease-in-out infinite alternate}.listening .wave view:nth-child(2n){animation-delay:-.3s}.processing .halo{animation:processing 1.8s linear infinite}.processing .core{opacity:.7}.orb[disabled]{background:transparent;color:inherit}.state{text-align:center;font-size:32rpx;line-height:1.5;margin-top:12rpx}.hint{text-align:center;color:#8ea6bc;font-size:25rpx;margin-top:16rpx}.footnote{text-align:center;font-size:22rpx;color:#617b93;margin-top:48rpx}.details{position:absolute;z-index:10;left:20rpx;right:20rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));padding:24rpx;background:#142439;border:1rpx solid #2a425b;border-radius:24rpx;box-shadow:0 0 80rpx #02060d}.history{height:35vh}.message{white-space:pre-wrap;font-size:28rpx;line-height:1.6;margin-bottom:24rpx}.who{display:block;color:#73e0dc;font-size:24rpx}.details textarea{height:100rpx;box-sizing:border-box;width:100%;font-size:28rpx;color:white;background:#0c1828;padding:16rpx;border-radius:12rpx}.details button{font-size:26rpx;min-height:44px;margin-top:10rpx}.page button:active{opacity:.85}@keyframes breathe{0%,100%{transform:scale(.94);opacity:.35}50%{transform:scale(1.09);opacity:.85}}@keyframes core-breathe{0%,100%{transform:scale(.97)}50%{transform:scale(1.03)}}@keyframes wave{from{transform:scaleY(.4)}to{transform:scaleY(1.15)}}@keyframes processing{0%{transform:rotate(0) scale(1);opacity:.3}50%{opacity:.9}100%{transform:rotate(360deg) scale(1);opacity:.3}}
.coaching-settings{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.coaching-settings button{margin:0;padding:0 20rpx;min-height:44px;line-height:44px;font-size:24rpx;background:#14283a;color:#a6d9e6;border-radius:24rpx}.coaching-settings button::after{border:0}.coaching-settings text{font-size:22rpx;color:#8daabd}.dialogue{margin-top:24rpx;height:25vh}

.listening .core{background:radial-gradient(circle at 30% 25%,#fff4b8,#ff9c54 40%,#e13a56);box-shadow:0 0 90rpx #e9545466}.listening .halo{border-color:#ffbd84;animation-duration:1s}.speaking .core{background:radial-gradient(circle at 30% 25%,#f4edff,#a78cff 40%,#5935b4)}.speaking .wave view{animation:wave .55s infinite alternate}.audio-status{text-align:center;color:#f1c998;font-size:24rpx;margin-top:16rpx}.state{font-weight:600}

.last-spoken{font-size:24rpx;color:#a2b8cc;max-height:70rpx;overflow:hidden;margin-top:8rpx;line-height:1.5}

.recovery-message{color:#b3f3d5;font-size:26rpx;line-height:1.6;text-align:center;margin-top:16rpx}
