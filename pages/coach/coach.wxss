.page{height:100vh;display:flex;flex-direction:column;background:#f4f6fa;box-sizing:border-box;padding:24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom))}.heading{padding:16rpx 0 24rpx}.title,.sub{display:block}.title{font-size:40rpx;font-weight:600;color:#182b49}.sub{font-size:26rpx;color:#65748a;margin-top:12rpx}.conversation{flex:1;min-height:0;height:0}.welcome,.message{padding:28rpx;border-radius:20rpx;background:#fff;margin-bottom:20rpx;font-size:30rpx;line-height:1.7;white-space:pre-wrap}.message.user{background:#e3edff}.who{display:block;font-size:24rpx;color:#536a89;margin-bottom:8rpx}.composer{padding-top:16rpx}.composer button{min-height:48px;font-size:28rpx;border-radius:16rpx}.voice{background:#174da6;color:#fff}.composer textarea{box-sizing:border-box;width:100%;height:130rpx;background:#fff;padding:20rpx;margin:16rpx 0;font-size:28rpx;border-radius:16rpx}.actions{display:flex;gap:16rpx;margin-top:12rpx}.actions button{flex:1}.notice,.sources{font-size:24rpx;color:#65748a;line-height:1.6}.notice{display:block;margin-top:12rpx}