<view class="page">
 <view class="top"><view><text class="brand">iSPEAKER</text><text class="subtitle">你的表达，值得被听见</text></view><button class="more" bindtap="more" aria-label="更多操作">···</button></view>
 <view class="coaching-settings"><button bindtap="chooseMode" disabled="{{busy || recording || starting}}">{{modeLabel}}⌄</button><button bindtap="chooseType" disabled="{{busy || recording || starting}}">{{typeLabel}}⌄</button><text wx:if="{{speechType === 'auto' && detectedLabel}}">当前：{{detectedLabel}}</text></view>
 <view class="material-progress"><view class="progress-head" bindtap="toggleProgress"><text>素材覆盖度 {{materialProgress.percent}}% · 估计</text><text>{{showProgress ? '收起' : '查看缺项'}}</text></view><progress percent="{{materialProgress.percent}}" stroke-width="4" activeColor="#79dcc9" backgroundColor="#26394c"/><text class="progress-hint">已记录 {{materialProgress.done}}/{{materialProgress.total}} 项 · {{materialProgress.remaining ? '下一项：' + materialProgress.next : '素材已覆盖，可以成稿'}}</text><text class="progress-hint">还可补 {{materialProgress.remaining}} 项，不必全部答完，随时先出初稿</text><button class="draft-now" bindtap="draft" disabled="{{busy || recording || starting || !messages.length}}">先整理一版</button><view wx:if="{{showProgress}}"><view class="material-item" wx:for="{{materialProgress.items}}" wx:key="id" bindtap="toggleMaterial" data-id="{{item.id}}"><text>{{item.done ? '✓' : '○'}} {{item.label}}</text><text class="progress-hint">{{item.evidence || item.hint}}</text></view><text class="progress-hint">依据你的原话估计，可点击校正；不是质量评分或剩余轮数。</text></view></view>
 <view class="dialogue"><text class="eyebrow">{{recording ? '正在聆听' : phase === 'recognizing' ? '正在识别' : phase === 'thinking' ? '正在思考' : phase === 'drafting' ? '正在整理稿件' : '演讲教练'}}</text><scroll-view scroll-y class="reply"><text selectable>{{partialReply || (messages.length ? messages[messages.length - 1].content : greeting)}}</text></scroll-view></view>
 <view class="last-spoken" wx:if="{{lastSpoken}}"><text>你刚才说：{{lastSpoken}}</text></view><view class="orb-stage"><button class="orb {{recording ? 'listening' : speaking ? 'speaking' : busy ? 'processing' : 'resting'}}" bindtap="onRecord" disabled="{{busy || starting}}" aria-label="{{recording ? '结束录音并发送' : '开始语音输入'}}"><view class="halo halo-one"></view><view class="halo halo-two"></view><view class="core"><view class="wave"><view></view><view></view><view></view><view></view><view></view></view></view></button></view>
 <text class="state">{{recording ? '我在听，点一下结束' : starting ? '正在开启麦克风' : phase === 'recognizing' ? '正在听懂你的想法…' : phase === 'thinking' ? (partialReply ? '正在组织内容，文字持续更新…' : '正在开始生成…') : phase === 'drafting' ? '正在把对话整理成稿…' : speaking ? '教练正在说话，点击可打断' : retryAvailable ? '原录音已保存 · 点击重试' : '麦克风已关闭 · 点击开始'}}</text>
 <text class="recovery-message" wx:if="{{recoveryMessage}}">{{recoveryMessage}}</text><text class="hint">{{recording ? '每段最多60秒，结束后自动发送' : '不必想好措辞，从一句话开始'}}</text>
 <view class="details" wx:if="{{showDetails}}"><scroll-view scroll-y class="history"><view class="message" wx:for="{{messages}}" wx:key="index"><text class="who">{{item.role === 'user' ? '我' : '教练'}}</text><text selectable>{{item.content}}</text></view><text wx:if="{{sources.length}}">参考：{{sources}}</text></scroll-view><textarea value="{{input}}" bindinput="onInput" placeholder="补充文字或修改识别内容后重新发送" maxlength="4000"/><button bindtap="send" disabled="{{busy || recording || starting || !input}}">发送补充</button><button bindtap="toggleDetails">收起</button></view>
 <text class="audio-status" wx:if="{{audioStatus}}">{{audioStatus}}</text><text class="footnote">AI 辅助表达 · 结束录音后识别与回复</text>
</view>