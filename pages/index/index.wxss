.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  box-sizing: border-box;
  background-color: #fff;
}

.header {
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.back-home {
  font-size: 32rpx;
  margin-right: 20rpx;
  padding: 10rpx;
}

.structure-progress {
  display: flex;
  align-items: center;
  flex: 1;
}

.progress-label {
  font-size: 22rpx;
  color: #999;
  margin-right: 12rpx;
}

.progress-dots {
  display: flex;
  gap: 8rpx;
}

.progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #eee;
}

.progress-dot.filled {
  background-color: #007aff;
}

.title-input {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.duration-info {
  font-size: 22rpx;
  color: #888;
}

.duration-text {
  color: #007aff;
}

.canvas {
  flex: 1;
  overflow: hidden;
  background-color: #fff;
}

.card-list {
  padding: 20rpx 0;
  position: relative;
  min-height: 100%;
}

/* 逻辑导轨线 */
.logic-rail {
  position: absolute;
  left: 46rpx;
  top: 40rpx;
  bottom: 40rpx;
  width: 2rpx;
  background-color: #eee;
  z-index: 1;
}

.card-wrapper {
  position: relative;
  z-index: 2;
  transition: all 0.2s;
  padding: 0 30rpx;
  margin-bottom: 0; /* 流式排列 */
}

.card-wrapper.dragging {
  position: absolute;
  z-index: 1000;
  opacity: 0.9;
  transform: scale(1.02);
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.1);
}

.card-container {
  display: flex;
  align-items: flex-start;
}

/* 导轨节点 */
.card-rail-node {
  width: 16rpx;
  height: 16rpx;
  background-color: #fff;
  border: 4rpx solid #ddd;
  border-radius: 50%;
  margin-top: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.active .card-rail-node {
  border-color: #007aff;
  background-color: #fff;
  width: 44rpx;
  height: 100rpx;
  border-radius: 22rpx;
  margin-left: -14rpx;
  margin-right: 14rpx;
}

.move-btn {
  height: 50rpx;
  width: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #007aff;
}

.card-content-box {
  flex: 1;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  flex: 1;
}

.card-type {
  font-size: 24rpx;
  color: #007aff;
  font-weight: bold;
  margin-right: 16rpx;
}

.card-intent {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
}

.card-duration-tag {
  font-size: 20rpx;
  color: #bbb;
  background-color: #f5f5f5;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.card-actions {
  display: flex;
}

.action-btn {
  padding: 10rpx;
  font-size: 28rpx;
  margin-left: 10rpx;
  color: #666;
}

.card-body {
  padding: 0;
}

.card-textarea {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.7;
  min-height: 120rpx; /* 提高默认高度，避免遮挡 */
  color: #333;
}

.active .card-textarea {
  color: #000;
}

/* AI 标识样式 */
.card-wrapper.is-ai .card-content-box {
  background-color: rgba(0, 122, 255, 0.04);
  border-radius: 12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.ai-badge {
  font-size: 18rpx;
  color: #007aff;
  background-color: rgba(0, 122, 255, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.quotes-list {
  margin-top: 16rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #eee;
}

.quote-item {
  display: flex;
  font-size: 26rpx;
  color: #777;
  margin-bottom: 8rpx;
}

.quote-lock {
  margin-right: 10rpx;
  font-size: 22rpx;
}

/* 占位符样式 */
.placeholder-box {
  padding: 20rpx 30rpx 20rpx 82rpx;
}

.placeholder-inner {
  height: 80rpx;
  border: 2rpx dashed #007aff;
  background-color: rgba(0, 122, 255, 0.05);
  border-radius: 8rpx;
}

.add-btn-minimal {
  padding: 60rpx 0 100rpx 82rpx;
  color: #ccc;
  font-size: 26rpx;
}

.footer {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footer-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.footer-btn text {
  font-size: 22rpx;
  color: #666;
}

/* AI 菜单样式保持不变 */
.ai-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-menu {
  width: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.2);
}

.ai-menu-title {
  padding: 30rpx;
  font-weight: bold;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 32rpx;
}

.ai-menu-item {
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #f9f9f9;
  font-size: 30rpx;
  color: #333;
}

.ai-menu-item:last-child {
  border-bottom: none;
}

/* AI 协作看板样式 */
.ai-hub {
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  max-height: 500rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.05);
}

.ai-hub-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fafafa;
}

.ai-hub-title-box {
  display: flex;
  align-items: center;
}

.ai-hub-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.ai-hub-count {
  background-color: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.ai-hub-toggle {
  font-size: 22rpx;
  color: #007aff;
}

.suggestion-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.suggestion-card {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #007aff;
}

.suggestion-text {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.5;
}

.suggestion-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.suggestion-btn {
  font-size: 24rpx;
  color: #007aff;
  padding: 10rpx 24rpx;
  border: 1rpx solid #007aff;
  border-radius: 30rpx;
}

.suggestion-btn.ignore {
  color: #999;
  border-color: #ddd;
}
